# Copy to .streamlit/secrets.toml and edit locally.
# Never commit the real file.
#
# One configuration file holds every setting and credential. Keep one copy per
# backend next to it (ignored by Git) and copy the one you want to use:
#   cp .streamlit/secrets.toml.<backend> .streamlit/secrets.toml   # then restart the app
# e.g. secrets.toml.splunkse (SaaS), secrets.toml.imlab-onprem (on-prem from a
# laptop), secrets.toml.imlab-onprem-k8s (on-prem inside Kubernetes).

# Logical backend profile name:
#   "splunkse"     Splunk AO SaaS tenant (default)
#   "imlab-onprem" Splunk AO On-prem (galileo_console_url required, no tenant path)
backend_profile = "splunkse"

# Splunk Agent Observability / Galileo
galileo_console_url = "https://console.multitenant.galileocloud.io"
galileo_api_key = "YOUR_GALILEO_API_KEY"

# Optional explicit overrides.
# Normally derived automatically from galileo_console_url:
#   API           console.<host> -> api.<host>
#   Agent Control splunkse: <console>/api/agent-control; imlab-onprem: <api>/agent-control
# galileo_api_url = "https://api.multitenant.galileocloud.io"
# agent_control_url = "https://console.multitenant.galileocloud.io/api/agent-control"
# Optional dedicated ingest-service URL for the SDK's native /ingest door
# (only needed when the API URL does not serve /ingest, e.g. inside a cluster).
# galileo_ingest_url = ""

# Agent Control
agent_control_agent_name = "splunk-ao-golden-demo"

# This is the HTTP HEADER NAME, not the API key itself.
# The header VALUE uses galileo_api_key.
# splunkse: "Galileo-API-Key"; imlab-onprem: "Splunk-AO-API-Key" (or "Galileo-API-Key").
agent_control_api_key_header = "Galileo-API-Key"

# Primary demo provider: Hosted (OpenAI)
openai_api_key = "YOUR_OPENAI_API_KEY"
openai_default_chat_model = "gpt-5.4-nano"
openai_embedding_model = "text-embedding-3-large"
openai_embedding_dimensions = 768
embedding_provider = "hosted"

# Local PostgreSQL + pgvector
postgres_host = "localhost"
postgres_port = "5432"
postgres_user = "postgres"
postgres_password = "YOUR_POSTGRES_PASSWORD"
postgres_db = "vectordb"
environment = "local"

# Optional upstream providers
# ollama_base_url = "http://localhost:11434"
# ollama_default_chat_model = "gemma4"
# ollama_embedding_model = "nomic-embed-text"

# bedrock_api_key = "YOUR_BEDROCK_API_KEY"
# aws_region = "us-east-1"
# bedrock_default_chat_model = "mistral.ministral-3-14b-instruct"
# bedrock_embedding_model = "amazon.titan-embed-text-v2:0"

# Optional OpenAI-compatible vLLM chat server (chat only; RAG embeddings stay on OpenAI).
# Tool calls returned as Hermes <tool_call> text are parsed by the app.
# vllm_base_url = "http://<vllm-service>.<namespace>.svc.cluster.local:8000/v1"
# vllm_default_chat_model = "Qwen/Qwen3-14B-FP8"
# vllm_api_key = ""

# ---------------------------------------------------------------------------
# Example: imlab-onprem used from a laptop (public addresses, derived from the Console URL)
# backend_profile = "imlab-onprem"
# galileo_console_url = "https://console.<AO_DOMAIN>"
# agent_control_api_key_header = "Splunk-AO-API-Key"
#
# Example: imlab-onprem inside the same Kubernetes cluster as Splunk AO.
# Every call uses AO's internal Service addresses (TLS from AO's internal CA,
# trusted through the CA bundle the Helm chart builds). galileo_console_url is
# then ONLY used for links opened by the presenter's browser.
# backend_profile = "imlab-onprem"
# galileo_console_url = "https://console.<AO_DOMAIN>"
# galileo_api_url = "https://api.galileo.svc.cluster.local:8088"
# galileo_ingest_url = "https://ingest-service.galileo.svc.cluster.local:8081"
# agent_control_url = "http://agent-control.galileo.svc.cluster.local:8000"
# agent_control_api_key_header = "Splunk-AO-API-Key"
# postgres_host = "<release>-postgres"
# environment = "k8s"
#
# Kubernetes deployment settings, read by deploy/k8s/scripts (not by the app).
# Keep this table LAST: everything after [k8s] belongs to it, and the scripts
# remove it before the file is stored as the app's Kubernetes Secret.
# [k8s]
# namespace = "sao-golden"
# app_host = "golden.<AO_DOMAIN>"
# ingress_class = "nginx"
# image = "<dockerhub-user>/sao-golden"
# postgres_node = "<node-name>"
# ao_ca_configmap = "galileo/galileo-internal-ca-cert"
# basic_auth_user = "<user>"
# basic_auth_password = "<password>"
