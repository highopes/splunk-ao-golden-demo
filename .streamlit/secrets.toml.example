# Copy to .streamlit/secrets.toml and edit locally.
# Never commit the real file.

# Logical backend profile name.
backend_profile = "splunkse"

# Splunk Agent Observability / Galileo
galileo_console_url = "https://console.multitenant.galileocloud.io"
galileo_api_key = "YOUR_GALILEO_API_KEY"

# Optional explicit overrides.
# Normally derived automatically from galileo_console_url.
# galileo_api_url = "https://api.multitenant.galileocloud.io"
# agent_control_url = "https://console.multitenant.galileocloud.io/api/agent-control"

# Agent Control
agent_control_agent_name = "splunk-ao-golden-demo"

# This is the HTTP HEADER NAME, not the API key itself.
# The header VALUE uses galileo_api_key.
agent_control_api_key_header = "Galileo-API-Key"

# Primary demo provider: Hosted (OpenAI)
openai_api_key = "YOUR_OPENAI_API_KEY"
openai_default_chat_model = "gpt-4o"
openai_embedding_model = "text-embedding-3-large"
openai_embedding_dimensions = 768
embedding_provider = "hosted"

# Local PostgreSQL + pgvector
postgres_host = "localhost"
postgres_port = "5432"
postgres_user = "postgres"
postgres_password = "YOUR_POSTGRES_PASSWORD"
postgres_db = "vectordb"
environment = "local"

# Optional upstream providers
# ollama_base_url = "http://localhost:11434"
# ollama_default_chat_model = "gemma4"
# ollama_embedding_model = "nomic-embed-text"

# bedrock_api_key = "YOUR_BEDROCK_API_KEY"
# aws_region = "us-east-1"
# bedrock_default_chat_model = "mistral.ministral-3-14b-instruct"
# bedrock_embedding_model = "amazon.titan-embed-text-v2:0"
